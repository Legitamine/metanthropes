{
	"name": "metanthropes-devtools",
	"version": "2.0.0",
	"description": "Development tools for Metanthropes System for Foundry VTT",
	"scripts": {
		"build": "sass --watch scss/metanthropes.scss styles/metanthropes.css",
		"packs:pack": "node src/dev-tools/compendium-handler.mjs pack",
		"packs:unpack": "node src/dev-tools/compendium-handler.mjs unpack",
		"createSymlinks": "node ./src/dev-tools/create-symlinks.mjs",
		"update": "npm run createSymlinks",
		"postinstall": "npm run createSymlinks"
	},
	"devDependencies": {
		"@foundryvtt/foundryvtt-cli": "^3.0.4",
		"js-yaml": "^4.1.1",
		"sass": "^1.69.5"
	}
}
