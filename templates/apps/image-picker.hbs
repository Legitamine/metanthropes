<section class="metanthropes-image-picker">
		<section class="selected-image">
			<header class="selected-image-header">
				<h4>{{#if isNarrator}}
					{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.Select"}} {{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.ActorType"}} {{localize (concat "METANTHROPES.UI.APPS.META_IMAGE_PICKER.ActorTypes."imageFolder)}}
					{{else}}
					{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.ActorType"}} {{localize (concat "METANTHROPES.UI.APPS.META_IMAGE_PICKER.ActorTypes."imageFolder)}}
					{{/if}}
				</h4>
			<div>
				<h5>
					{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.Selected"}}
				</h5>
				<img class="selected-image-img" loading="lazy" src="{{this.selected}}" alt="">
			</div>
				<hr>
			<div>
				<p class="menu">{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.Menu"}}</p>
				<p class="menu">{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.Token"}}</p>
				<hr>
			</div>
			</header>
		</section>
	{{#if hasImages}}
		{{#each paths}}
			<section class="image-group">
				<header class="image-group-header">
					<div class="image-group-key">
						<h3>{{localize (concat "METANTHROPES.MODULES."registryKey)}} | {{localize (concat "METANTHROPES.UI.APPS.META_IMAGE_PICKER.ActorTypes."folderName)}}</h3>
					</div>
				</header>
				<div class="image-grid">
					{{#each images}}
						<button type="button" class="image-card{{#if isSelected}} selected{{/if}}"
							{{#if isSelected}}data-tooltip="METANTHROPES.UI.APPS.META_IMAGE_PICKER.Selected"{{/if}}
							data-action="selectImage" data-path="{{path}}">
							<img loading="lazy" src="{{path}}" alt="{{name}}">
							<span class="image-name">{{name}}</span>
						</button>
					{{/each}}
				</div>
			</section>
			<br>
			<hr>
		{{/each}}
	{{else}}
		<p>{{localize "METANTHROPES.UI.APPS.META_IMAGE_PICKER.Error"}}</p>
	{{/if}}
</section>