<header>Name: {{actor.name}} Species: {{species}} - Templates: {{templates}}
	<section class="flexrow">
		<img>
		<div>
			Life:
			in-{{resources.life.initial}}/cur-{{resources.life.current}}/bas-{{resources.life.base}}/max-{{resources.life.max}}
		</div>
		<div>
			Player
		</div>
		<div>
			Exp
		</div>
	</section>
	<section class="flexrow">
		{{#each system.chars}}
			<div class="flexrow" data-tooltip="{{lookup (lookup @root.charsFields @key) "hint"}}">
				{{lookup (lookup @root.charsFields @key) "label"}} {{this.current}}
				{{#each ../system.stats}}
					{{#if (eq (lookup (lookup @root.statsConst @key) "associatedChar") @../key)}}
						<div data-tooltip="{{lookup (lookup @root.statsFields @key) "hint"}}">
							{{lookup (lookup @root.statsFields @key) "label"}}
							<h3
								data-tooltip="{{lookup (lookup (lookup (lookup @root.statsFields @key) "fields") "current") "hint"}}">
								{{this.current}}
							</h3>
						</div>
					{{/if}}
				{{/each}}
			</div>
		{{/each}}
	</section>
</header>