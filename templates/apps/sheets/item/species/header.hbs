<header class="sheet-header flexcol">
	<img class="item-image" src="{{item.img}}" alt="{{item.name}}" title="{{item.name}}" {{#if editable}}data-edit="img"
		{{/if}} draggable="false">
	<h3>
		{{formGroup
		fields.name
		value=source.name
		name="name"
		label="Species"
		rootId=rootId
		disabled=(not isNarrator)
	}}
	</h3>
</header>