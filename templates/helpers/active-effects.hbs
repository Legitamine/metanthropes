{{log "APP V1 controls" this}}
<ol class="items-list effects-list">
	{{#each effects as |section|}}
		<li class="effects-category" data-effect-type="{{section.type}}">
			<div class="items-header flexrow">
				<h4 class="item-name effect-name flexrow">
					{{localize section.label}}
				</h4>
				<div class="effect-source">Source</div>
				<div class="effect-duration">Duration</div>
				{{#if ../isNarrator}}
					<div class="item-controls effect-controls flexrow">
						<a class="effect-control" data-action="effectCreate"
							data-tooltip="METANTHROPES.ACTOR.SHEET.AE.addEffect">
							<i class="fas fa-plus"></i>
							{{localize "METANTHROPES.ACTOR.SHEET.AE.add"}}
						</a>
					</div>
				{{/if}}
			</div>
			<ol class="item-list">
				{{#each section.effects as |effect|}}
					<li class="item effect flexrow" data-effectuuid="{{effect.uuid}}">
						<div class="item-name effect-name flexrow">
							<img class="item-image" src="{{effect.img}}" alt="{{effect.name}}" />
							<h4>
								<a class="effect-control effect-edit style-view-properties" data-action="effectEdit"
									data-actoruuid="{{actor.uuid}}" data-tooltip="Click to open {{effect.name}}"
									data-effectuuid="{{effect.uuid}}">
									{{effect.name}}
								</a>
							</h4>
						</div>
						<div class="effect-source">
							{{effect.sourceName}}
						</div>
						<div class="effect-duration">
							{{effect.duration.label}}
						</div>
						{{#if ../../isNarrator}}
							<div class="item-controls effect-controls flexrow">
								<a class="effect-control" data-action="effectToggle" data-effectuuid="{{effect.uuid}}"
									data-actoruuid="{{actor.uuid}}"
									data-tooltip="METANTHROPES.ACTOR.SHEET.AE.toggleEffect"><i
										class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
								</a>
								<a class="effect-control" data-action="effectRefresh" data-effectuuid="{{effect.uuid}}"
									data-actoruuid="{{actor.uuid}}"
									data-tooltip="METANTHROPES.ACTOR.SHEET.AE.resetEffect"><i
										class="fas {{#if effect.duration.expired}}fa-refresh{{else}}fa-hourglass{{/if}}"></i>
								</a>
								<a class="effect-control" data-action="effectDelete" data-effectuuid="{{effect.uuid}}"
									data-actoruuid="{{actor.uuid}}"
									data-tooltip="METANTHROPES.ACTOR.SHEET.AE.removeEffect"><i
										class="fa-solid fa-trash"></i>
								</a>
							</div>
						{{/if}}
					</li>
				{{/each}}
			</ol>
		</li>
	{{/each}}
</ol>